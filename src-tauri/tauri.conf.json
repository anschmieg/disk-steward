{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Steward",
  "version": "0.0.2",
  "identifier": "com.disksteward.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Steward",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Understand and review disk cleanup",
    "longDescription": "A careful, evidence-led desktop app for understanding storage and reviewing cleanup plans."
  }
}
