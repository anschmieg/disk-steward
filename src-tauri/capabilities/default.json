    "allow-prepare-fixture-stage",
    "allow-prepare-fixture-restore",
    "allow-request-fixture-execution",
    "allow-prepare-purge-review",
    "allow-confirm-purge-execution",
    "allow-get-general-plan",
    "allow-edit-general-plan",
    "allow-undo-general-plan",
    "allow-redo-general-plan",
    "allow-freeze-general-review",
    "allow-get-general-review",
    "allow-list-general-reviews",
    "allow-add-selected-general-item",
